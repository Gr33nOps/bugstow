# ── BugsTow team server configuration ────────────────────────────────────────
# Copy this file to `.env` next to the docker-compose file you use:
#   repo:            cp server/.env.example .env
#   offline bundle:  cd team && cp .env.example .env
# then fill in the values below.

# REQUIRED. Secret used to sign session cookies. Keep it private.
# Generate one with:  openssl rand -base64 32
BUGSTOW_AUTH_SECRET=

# The address people type in their browser to reach this server. It must match
# exactly (scheme, host, port) or sign-in will not stick.
#
#   Trying it on this computer only:   http://localhost:8080
#   Teammates on your network (RECOMMENDED: HTTPS, see below):
#                                      https://192.168.1.20:8080
#
# Plain http:// on a LAN address works but is NOT encrypted: passwords and issues
# cross the network readable by anyone on it.
BUGSTOW_BASE_URL=http://localhost:8080

# HTTPS with a certificate generated on this computer (no outside service).
# Turn on whenever other computers connect, and use https:// in BUGSTOW_BASE_URL.
# Teammates trust the certificate once: docs/RELEASE_OFFLINE.md §7.
BUGSTOW_TLS=false
# Extra names/IPs the generated certificate should cover (comma-separated).
# The BUGSTOW_BASE_URL host is always included.
# BUGSTOW_TLS_HOSTS=bugstow.lan
# Use your own certificate instead of the generated one:
# BUGSTOW_TLS_CERT=/data/certs/server.crt
# BUGSTOW_TLS_KEY=/data/certs/server.key

# Port the server listens on (inside the container). Map it in docker-compose.
PORT=8080

# Where the SQLite database and screenshots are stored inside the container.
# The docker-compose volume mounts a named volume here; usually leave as-is.
BUGSTOW_DATA_DIR=/data

# false (default) = invite-only after the first administrator is created.
# true            = anyone who can reach the server can register.
BUGSTOW_OPEN_SIGNUP=false

# Offline mode. true (default) disables the only internet feature (GitHub
# import). Set false only if you want GitHub import and have connectivity.
BUGSTOW_OFFLINE=true

# ── Backups (docs/RELEASE_OFFLINE.md §8) ─────────────────────────────────────
BUGSTOW_BACKUP_ENABLED=true
BUGSTOW_BACKUP_INTERVAL_HOURS=24
BUGSTOW_BACKUP_RETENTION=7
# STRONGLY RECOMMENDED: a second copy on separate hardware (another drive, USB
# disk, NAS). /data/backups alone does not survive losing this disk.
# 1. mount the folder in docker-compose (see the commented volume line),
# 2. create an empty `.bugstow-backup-target` file in it,
# 3. set:
# BUGSTOW_BACKUP_EXTERNAL_DIR=/backup-external
# BUGSTOW_BACKUP_EXTERNAL_RETENTION=14

# ── Encrypted backups to your own cloud (docs/CLOUD_SYNC.md) ─────────────────
# Required for any cloud target; nothing is uploaded without it. Keep it safe:
# without it the cloud archives can't be restored.
# BUGSTOW_BACKUP_ENCRYPTION_PASSPHRASE=
# A folder synced by a cloud desktop app (Google Drive, Dropbox, OneDrive, Mega,
# Terabox...). Mount it in docker-compose and create .bugstow-backup-target in it.
# BUGSTOW_BACKUP_CLOUD_DIR=/backup-cloud
# And/or a WebDAV folder (Nextcloud, ownCloud, pCloud, Koofr, Synology...):
# BUGSTOW_BACKUP_WEBDAV_URL=https://webdav.example.com/BugsTow/
# BUGSTOW_BACKUP_WEBDAV_USER=
# BUGSTOW_BACKUP_WEBDAV_PASSWORD=
# BUGSTOW_BACKUP_CLOUD_RETENTION=14

# ── Rarely needed ────────────────────────────────────────────────────────────

# Only if a reverse proxy (Caddy/nginx) is in front of the server: the number
# of proxies to trust for client IPs (usually 1). Leave unset for direct/LAN
# access, otherwise clients could fake their IP to dodge sign-in limits.
# BUGSTOW_TRUST_PROXY=1

# Fixed first-administrator setup token (20+ characters) for scripted installs.
# Normally leave unset: a random one-time token is printed in the server log.
# BUGSTOW_SETUP_TOKEN=

# Additional allowed origins for auth (comma-separated).
# BUGSTOW_TRUSTED_ORIGINS=

# Maximum screenshot upload size in bytes (default 10 MB).
# BUGSTOW_MAX_UPLOAD_BYTES=10485760
