# ── Bugstow team server configuration ────────────────────────────────────────
# Copy this file to a `.env` in the repo root (next to docker-compose.yml):
#   cp server/.env.example .env
# then fill in BUGSTOW_AUTH_SECRET.

# REQUIRED. Secret used to sign session cookies. Keep it private.
# Generate one with:  openssl rand -base64 32
BUGSTOW_AUTH_SECRET=

# The URL teammates use to reach this server. For LAN access use the host's IP.
#   LAN example:     http://192.168.1.20:8080
#   Domain (HTTPS):  https://bugstow.example.com
# This must match how the browser reaches the server, or sign-in cookies fail.
BUGSTOW_BASE_URL=http://localhost:8080

# Port the server listens on (inside the container). Map it in docker-compose.
PORT=8080

# Where the SQLite database and screenshots are stored inside the container.
# The docker-compose volume mounts a named volume here; usually leave as-is.
BUGSTOW_DATA_DIR=/data

# false (default) = invite-only after the first admin is created.
# true            = anyone who can reach the server can self-register.
BUGSTOW_OPEN_SIGNUP=false

# ── Offline / LAN options (see docs/OFFLINE.md) ──────────────────────────────

# Strict offline mode. true (default) disables the only internet-touching
# feature (GitHub import). Set false only if you want GitHub import + have
# connectivity.
BUGSTOW_OFFLINE=true

# Serve over HTTPS with an auto-generated self-signed certificate that covers
# localhost and all of this host's LAN IPs. Recommended for LAN/remote access.
BUGSTOW_TLS=false
# To use your own certificate instead of the generated one:
# BUGSTOW_TLS_CERT=/data/certs/server.crt
# BUGSTOW_TLS_KEY=/data/certs/server.key

# Automatic local backups (stored under /data/backups). Restore procedure is in
# docs/OFFLINE.md.
BUGSTOW_BACKUP_ENABLED=true
BUGSTOW_BACKUP_INTERVAL_HOURS=24
BUGSTOW_BACKUP_RETENTION=7

# Only if a reverse proxy (Caddy/nginx) is in front of the server: the number
# of proxies to trust for client IPs (usually 1). Leave unset for direct/LAN
# access, otherwise clients could spoof their IP to dodge rate limits.
# BUGSTOW_TRUST_PROXY=1

# Optional: additional allowed origins for auth (comma-separated). Rarely needed
# since the app and API are served from the same origin.
# BUGSTOW_TRUSTED_ORIGINS=

# Optional: maximum screenshot upload size in bytes (default 10 MB).
# BUGSTOW_MAX_UPLOAD_BYTES=10485760
