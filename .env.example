# Cloudflare R2 credentials for Bugstow cloud sync (set these in Vercel too).
# Create an R2 bucket + an "R2 Token" (S3 API) in the Cloudflare dashboard.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=bugstow

# Optional: a shared secret to gate the sync endpoint. Leave unset for no auth.
# When set here, also store it in the app via localStorage key "bugstow_sync_key".
# BUGSTOW_SYNC_KEY=
