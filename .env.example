# ─────────────────────────────────────────────────────────────────────────────
# TEAM / CLOUD MODE (Neon)  — required for the shared, multi-user team workspace.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres pooled connection string (secret). From the Neon console.
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require

# Neon Managed Better Auth (from `provision_neon_auth` / Neon console → Auth).
# VITE_ vars are exposed to the browser; the others are server-only.
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL-MODE CLOUD BACKUP (optional, Cloudflare R2). Independent of team mode.
# Create an R2 bucket + an "R2 Token" (S3 API) in the Cloudflare dashboard.
# ─────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=bugstow

# Optional: a shared secret to gate the R2 sync endpoint. Leave unset for no auth.
# When set here, also store it in the app via localStorage key "bugstow_sync_key".
# BUGSTOW_SYNC_KEY=
